{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pedido de similaridade, contrato aberto v1 (forma do TEI)",
  "type": "object",
  "required": ["inputs"],
  "properties": {
    "inputs": {
      "type": "object",
      "required": ["source_sentence", "sentences"],
      "properties": {
        "source_sentence": {"type": "string", "description": "O texto de origem, comparado com cada item de sentences."},
        "sentences": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "parameters": {
      "type": ["object", "null"],
      "properties": {"prompt_name": {"type": ["string", "null"], "description": "Recusado pela casa: o modelo não tem prompts."}}
    }
  },
  "additionalProperties": true
}
